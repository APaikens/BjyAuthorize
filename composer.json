{
    "name":         "kokspflanze/bjy-authorize",
    "description":  "Laminas\\Acl based firewall system for Laminas/ZF2/3 dispatch protection",
    "type":         "library",
    "license":      "BSD-3-Clause",
    "homepage":     "https://github.com/kokspflanze/BjyAuthorize",
    "keywords": [
        "laminas",
        "zf",
        "zf2",
        "zf3",
        "acl",
        "lmc-user",
        "zfc-user"
    ],
    "authors": [
        {
            "name":      "Ben Youngblood",
            "email":     "bx.youngblood@gmail.com",
            "homepage":  "http://bjyoungblood.com/",
            "role":      "Developer"
        },
        {
            "name":      "Marco Pivetta",
            "email":     "ocramius@gmail.com",
            "homepage":  "http://ocramius.github.com/",
            "role":      "Developer"
        }
    ],
    "require": {
        "php": "^8.0.0 || ^8.1.0 || ^8.2.0 || ^8.3.0 || ^8.4.0 || ^8.5.0",
        "laminas/laminas-permissions-acl": "^2.18.0",
        "laminas/laminas-mvc":             "dev-I-51993",
        "laminas/laminas-eventmanager":    "^3.15",
        "laminas/laminas-servicemanager":  "^4.5.1",
        "laminas/laminas-http":            "^2.14",
        "laminas/laminas-view":            "^2.23",
        "laminas/laminas-authentication":  "^2.19",
        "laminas/laminas-cache":           "^4.3",
        "laminas/laminas-cache-storage-adapter-memory": "^3.2.0"
    },
    "replace": {
        "laminas/laminas-cache-storage-adapter-apc": "*",
        "laminas/laminas-cache-storage-adapter-mongodb": "*",
        "laminas/laminas-cache-storage-adapter-wincache": "*",
        "laminas/laminas-cache-storage-adapter-xcache": "*",
        "laminas/laminas-cache-storage-adapter-zend-server": "*",
        "laminas/laminas-cache-storage-adapter-dba": "*"
    },
    "require-dev": {
        "phpunit/phpunit":                 "^9.5",
        "laminas/laminas-cli":             "^1.1.1",
        "laminas/laminas-db":              "^2.13.4",
        "doctrine/persistence":            "^1.3.3 || ^2.0",
        "laminas/laminas-developer-tools": "^2.1",
        "lm-commons/lmc-user":             "^3.1"
    },
    "suggests": {
        "laminas/laminas-developer-tools": "if you need to see current authorization details while developing",
        "lm-commons/lmc-user":             "LmcUser provides a good default setup to get started with bjyauthorize",
        "lm-commons/lmc-user-doctrine-orm": "To support Doctrine with LmcUser"
    },
    "autoload": {
        "psr-4": {
            "BjyAuthorize\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BjyAuthorizeTest\\": "test/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always --configuration phpunit.xml.dist"
    }
}
